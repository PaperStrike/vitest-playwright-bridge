{
  "name": "vitest-playwright-bridge",
  "version": "0.0.0",
  "description": "Bridge to interact with Playwright directly from Vitest browser tests, enabling advanced browser control and access to Playwright features.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "watch": "vitest --browser.headless=false",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsdown",
    "lint": "eslint .",
    "prepare": "pnpm build"
  },
  "keywords": [
    "vitest",
    "playwright",
    "bridge",
    "browser",
    "testing",
    "plugin",
    "vitest-plugin",
    "network",
    "routing",
    "page",
    "context"
  ],
  "repository": "github:PaperStrike/vitest-playwright-bridge",
  "license": "MIT",
  "files": [
    "dist",
    "CHANGELOG.*"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "rolldown": "^1.0.1",
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "@vitest/browser-playwright": "^4.0.0",
    "playwright": "*",
    "vitest": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/config-helpers": "^0.6.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.7.0",
    "@vitest/browser-playwright": "^4.1.6",
    "birpc": "^4.0.0",
    "eslint": "^10.3.0",
    "msgpackr": "^2.0.1",
    "playwright": "^1.60.0",
    "rolldown-plugin-babel-decorators": "^1.0.1",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
