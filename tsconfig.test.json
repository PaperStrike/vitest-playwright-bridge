{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "vitest-playwright-bridge/*": ["./src/*"]
    },
    "tsBuildInfoFile": "./build/.cache/test.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/**/*.test.*",
    "test"
  ],
  "references": [
    { "path": "./tsconfig.build.json" }
  ]
}
